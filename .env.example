# ==================================================
# Aaruu Music - Environment Variables
# ==================================================

# Mandatory Telegram Bot Token obtained from @BotFather
BOT_TOKEN=

# Numeric Telegram ID of the primary bot owner
OWNER_ID=

# Numeric Telegram IDs for designated sudo users (comma or space separated)
SUDO_USERS=

# ==================================================
# Optional Configurations
# ==================================================

# Optional MTProto user session string for group voice-chat streaming
# If omitted, the bot runs fully in standalone Rich Message & Queue mode
ASSISTANT_SESSION=

# Database connection URL (defaults to local SQLite: aaruu_music.db)
DATABASE_URL=sqlite:///aaruu_music.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional path to Netscape-format YouTube cookies file for yt-dlp
YTDLP_COOKIES=

# Platform internal hosting variables (if applicable)
GEMINI_API_KEY=
APP_URL=
